{
  "manifest_version": 3,
  "name": "Gonbi Viewport",
  "version": "1.2.0",
  "description": "Preview any website inside 60 realistic phone, tablet and laptop viewports. Fuzzy device search, rotate, zoom and screenshot.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "cookies",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "debugger",
    "tabCapture",
    "activeTab"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Gonbi Viewport",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
